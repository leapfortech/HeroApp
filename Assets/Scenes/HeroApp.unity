  m_Name: 
  m_EditorClassIdentifier: 
  choiceDialogType: 0
  title: Cpe
  message: "La persona individual o jur\xEDdica, nacional o extranjera, que sin importar
    la modalidad de la adquisici\xF3n p\xFAblica, provea o venda bienes, suministros,
    obras, servicios o arrendamientos al Estado o a cualquiera de las entidades,
    instituciones o sujetos indicados en el art\xEDculo 1 de la Ley de Contrataciones
    del Estado, por valor que exceda a novecientos mil quetzales (Q900,000.00), en
    uno o varios contratos, no importando la modalidad de adquisici\xF3n p\xFAblica.\n"
  btnTitleOK: Entendido
  btnTitleKO: 
  btnAction: {fileID: 1102872474}
  onOK:
    m_PersistentCalls:
